// -------------------------------------------
// Prisma Schema for NationCite System
// -------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

////////////////////////////////////////////////
// ENUMS
////////////////////////////////////////////////

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  ADMIN
  SCHOLAR
  ORG
}


////////////////////////////////////////////////
// AUTH / CREDENTIALS
////////////////////////////////////////////////

model AuthUser {
  id              Int      @id @default(autoincrement())

  email           String   @unique
  passwordHash    String
  role            UserRole @default(SCHOLAR)

  isEmailVerified Boolean  @default(false)
  isActive        Boolean  @default(true)

  lastLoginAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  registration    Registration?
}


////////////////////////////////////////////////
// PUBLIC SCHOLARS (NO LOGIN)
////////////////////////////////////////////////

model ScholarsPublic {
  id               Int      @id @default(autoincrement())
  nationciteId     String   @unique
  worldRank        Int?
  countryRank      Int?
  universityRank   Int?
  scholarName      String
  orgName          String
  mainSubject      String?
  subField         String?
  hIndexTotal      Int
  hIndexLast5      Int
  hIndexRatio      Float
}

////////////////////////////////////////////////
// PUBLIC ORGANIZATIONS (NO LOGIN)
////////////////////////////////////////////////

model OrgsPublic {
  id             Int      @id @default(autoincrement())
  nationciteId   String   @unique
  worldRank      Int?
  countryRank    Int?
  orgName        String
  hIndexTotal    Int
  hIndexLast5    Int
}

////////////////////////////////////////////////
// REGISTRATION (PARENT + APPROVAL AUTHORITY)
////////////////////////////////////////////////

model Registration {
  id             Int      @id @default(autoincrement())
  nationciteId   String
  type           String
  status         RegistrationStatus @default(PENDING)
  authUserId     Int?     @unique
  ticketId       String?

  // Relations
  authUser       AuthUser? @relation(fields: [authUserId], references: [id])
  ticket         Tickets?  @relation(fields: [ticketId], references: [ticketId])

  medical        MedicalProfessional?
  researcher     Researchers?
  orgReg         OrgsRegistered?
}

////////////////////////////////////////////////
// MEDICAL PROFESSIONAL
////////////////////////////////////////////////

model MedicalProfessional {
  id                   Int     @id @default(autoincrement())
  registrationId       Int?     @unique
  nationciteId         String?
  name                 String
  medCouncilRegNo      String
  stateCouncil         String
  mobile               String
  email                String
  primaryHospital      String
  specialty            String
  researchFocus        String
  medicalDegreeUrl     String?
  regCertificateUrl    String?
  status               String
  plan                 String

  // Relations
  registration Registration? @relation(fields: [registrationId], references: [id])
}

////////////////////////////////////////////////
// RESEARCHERS
////////////////////////////////////////////////

model Researchers {
  id                        Int     @id @default(autoincrement())
  registrationId            Int?     @unique
  nationciteId              String?
  name                      String
  institute                 String
  instituteEmail            String
  orcidId                   String
  institutionalIdCardUrl    String?
  mobile                    String
  email                     String
  primaryDomain             String
  googleScholarUrl          String
  profilePhotoUrl           String
  status                    String
  plan                      String

  // Relations
  registration Registration? @relation(fields: [registrationId], references: [id])
}

////////////////////////////////////////////////
// REGISTERED ORGANIZATIONS
////////////////////////////////////////////////

model OrgsRegistered {
  id                        Int     @id @default(autoincrement())
  registrationId            Int?     @unique
  nationciteId              String?
  domain                    String
  name                      String
  email                     String
  number                    String
  letterOfAuthorizationUrl  String
  accreditationProofUrl     String
  status                    String
  plan                      String

  // Relations
  registration Registration? @relation(fields: [registrationId], references: [id])
}

////////////////////////////////////////////////
// TICKETS (ADMIN WORKFLOW)
////////////////////////////////////////////////

model Tickets {
  id           Int       @id @default(autoincrement())
  ticketId     String    @unique
  nationciteId String
  name         String
  type         String
  issueType    String
  description  String
  status       String
  createdAt    DateTime
  updatedAt    DateTime

  // Relations
  registration Registration[]
  comments     TicketComments[]
}

////////////////////////////////////////////////
// TICKET COMMENTS
////////////////////////////////////////////////

model TicketComments {
  id          Int      @id @default(autoincrement())
  ticketId    String
  comments    String
  attachments String?
  createdAt   DateTime

  // Relations
  ticket Tickets @relation(fields: [ticketId], references: [ticketId])
}

////////////////////////////////////////////////
// PUBLICATIONS
////////////////////////////////////////////////

model Publication {
  id                 Int      @id @default(autoincrement())
  title              String
  journalName        String
  datePublished      DateTime
  citationsTotal     Int
  citationsLast5Years Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  scholars           PublicationScholar[]
  orgs               PublicationOrg[]
}

model PublicationScholar {
  publication        Publication @relation(fields: [publicationId], references: [id])
  publicationId      Int
  scholarNationciteId String     @db.VarChar(256) // link to ScholarsPublic.nationciteId

  @@id([publicationId, scholarNationciteId])
}

model PublicationOrg {
  publication       Publication @relation(fields: [publicationId], references: [id])
  publicationId     Int
  orgNationciteId   String     @db.VarChar(256) // link to OrgsPublic.nationciteId

  @@id([publicationId, orgNationciteId])
}
