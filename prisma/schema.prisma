// -------------------------------------------
// Prisma Schema for NationCite System
// -------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

////////////////////////////////////////////////
// ENUMS
////////////////////////////////////////////////

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  ADMIN
  SCHOLAR
  ORG
}

enum LoginType {
  ADMIN
  RESEARCHER
  MEDICAL_PROFESSIONAL
  ORG
}


////////////////////////////////////////////////
// AUTH / CREDENTIALS
////////////////////////////////////////////////

model AuthUser {
  id              Int      @id @default(autoincrement())

  email           String   @unique
  passwordHash    String
  role            UserRole @default(SCHOLAR)

  isEmailVerified Boolean  @default(false)
  isActive        Boolean  @default(true)

  lastLoginAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  registration    Registration?
  blogs           Blog[]
}


////////////////////////////////////////////////
// PUBLIC SCHOLARS (NO LOGIN)
////////////////////////////////////////////////

model ScholarsPublic {
  id               Int      @id @default(autoincrement())
  nationciteId     String   @unique
  worldRank        Int?
  countryRank      Int?
  universityRank   Int?
  scholarName      String
  orgName          String
  mainSubject      String?
  subField         String?
  hIndexTotal      Int
  hIndexLast5      Int
  hIndexRatio      Float
}

////////////////////////////////////////////////
// PUBLIC ORGANIZATIONS (NO LOGIN)
////////////////////////////////////////////////

model OrgsPublic {
  id             Int      @id @default(autoincrement())
  nationciteId   String   @unique
  worldRank      Int?
  countryRank    Int?
  orgName        String
  hIndexTotal    Int
  hIndexLast5    Int
}

////////////////////////////////////////////////
// REGISTRATION (PARENT + APPROVAL AUTHORITY)
////////////////////////////////////////////////

model Registration {
  id             Int      @id @default(autoincrement())
  nationciteId   String
  type           String
  status         RegistrationStatus @default(PENDING)
  authUserId     Int?     @unique
  ticketId       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  authUser       AuthUser? @relation(fields: [authUserId], references: [id])
  ticket         Tickets?  @relation(fields: [ticketId], references: [ticketId])

  medical        MedicalProfessional?
  researcher     Researchers?
  orgReg         OrgsRegistered?
}

////////////////////////////////////////////////
// MEDICAL PROFESSIONAL
////////////////////////////////////////////////

model MedicalProfessional {
  id                   Int     @id @default(autoincrement())
  registrationId       Int?     @unique
  nationciteId         String?
  name                 String
  medCouncilRegNo      String
  stateCouncil         String
  mobile               String   @unique
  email                String
  primaryHospital      String
  specialty            String
  researchFocus        String
  medicalDegreeUrl     String?
  regCertificateUrl    String?
  status               String
  plan                 String
  city                 String   @db.VarChar(100)
  state                String   @db.VarChar(100)
  linkedAccounts       String[] @default([])

  // Relations
  registration Registration? @relation(fields: [registrationId], references: [id])
}

////////////////////////////////////////////////
// RESEARCHERS
////////////////////////////////////////////////

model Researchers {
  id                        Int     @id @default(autoincrement())
  registrationId            Int?     @unique
  nationciteId              String?
  name                      String
  institute                 String
  instituteEmail            String
  orcidId                   String
  institutionalIdCardUrl    String?
  mobile                    String    @unique
  email                     String
  primaryDomain             String
  googleScholarUrl          String
  profilePhotoUrl           String
  status                    String
  plan                      String
  city                 String   @db.VarChar(100)
  state                String   @db.VarChar(100)
  linkedAccounts       String[] @default([])

  // Relations
  registration Registration? @relation(fields: [registrationId], references: [id])
}

////////////////////////////////////////////////
// REGISTERED ORGANIZATIONS
////////////////////////////////////////////////

model OrgsRegistered {
  id                        Int     @id @default(autoincrement())
  registrationId            Int?     @unique
  nationciteId              String?
  domain                    String
  name                      String
  email                     String
  number                    String    @unique
  letterOfAuthorizationUrl  String
  accreditationProofUrl     String
  status                    String
  plan                      String
  city                 String   @db.VarChar(100)
  state                String   @db.VarChar(100)
  linkedAccounts       String[] @default([])

  // Relations
  registration Registration? @relation(fields: [registrationId], references: [id])
}

////////////////////////////////////////////////
// TICKETS (ADMIN WORKFLOW)
////////////////////////////////////////////////

model Tickets {
  id           Int       @id @default(autoincrement())
  ticketId     String    @unique
  nationciteId String
  name         String
  type         String
  issueType    String
  description  String
  status       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  issueReason      String?     
  links            String[]    
  attachments      String[]   
  impactLevel      String?    
  preferredOutcome String?     

  // Relations
  registration Registration[]
  comments     TicketComments[]
}

////////////////////////////////////////////////
// TICKET COMMENTS
////////////////////////////////////////////////

model TicketComments {
  id          Int      @id @default(autoincrement())
  ticketId    String
  comments    String
  createdAt   DateTime

  // Relations
  ticket Tickets @relation(fields: [ticketId], references: [ticketId])
}

////////////////////////////////////////////////
// PUBLICATIONS
////////////////////////////////////////////////

model Publication {
  id                  Int       @id @default(autoincrement())
  nationciteId        String    
  title               String
  journalName         String
  datePublished       DateTime
  field               String
  citationsTotal      Int       @default(0)
  citationsLast5Years Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

////////////////////////////////////////////////
// OTP AUTHENTICATION (MOBILE LOGIN)
////////////////////////////////////////////////

model Otp {
  id          Int      @id @default(autoincrement())

  mobile      String   @db.VarChar(20)
  otpHash     String   // hashed OTP
  expiresAt   DateTime
  attempts    Int      @default(0)
  verified    Boolean  @default(false)

  createdAt   DateTime @default(now())

  @@index([mobile])
}

model LoginLog {
  id           Int       @id @default(autoincrement())
  nationciteId String    @db.VarChar(50)
  loginType    LoginType
  createdAt    DateTime  @default(now())

  @@index([nationciteId])
  @@index([loginType])
  @@index([createdAt])
}

////////////////////////////////////////////////
// BLOGS
////////////////////////////////////////////////

model Blog {
  id            Int       @id @default(autoincrement())
  nationciteId  String
  title         String
  subtitle      String?
  mainText      String    @db.Text
  images        String[]  // Array of image URLs

  authorId      Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  author        AuthUser  @relation(fields: [authorId], references: [id])

  @@index([nationciteId])
  @@index([authorId])
  @@index([createdAt])
}
